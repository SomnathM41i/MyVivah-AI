APP_NAME=MyVivahAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL via Windows XAMPP/MariaDB; Windows PHP reaches it on 127.0.0.1) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myvivah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Phase 5A: public site + auth mail. Dev/test default to the `log` mailer —
#     switch to smtp/mailgun/etc. with real credentials before launch. ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@myvivahai.digitalji.in
MAIL_FROM_NAME="${APP_NAME}"
# Where the public Contact form and system emails may be delivered in production.
MAIL_TO_ADDRESS=support@myvivahai.digitalji.in

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Phase 3E realtime toggle: gate event dispatch (REST works regardless).
CHAT_REALTIME_ENABLED=false
CHAT_PRESENCE_OFFLINE_AFTER=90

# --- Phase 4 widget session + realtime coordinates (also mirrored in config/chat.php) ---
# `connection` = 'reverb' | 'pusher' | 'none' (falls back to broadcasting.default).
CHAT_REALTIME_CONNECTION=reverb
CHAT_REALTIME_SCHEME=wss
CHAT_REALTIME_HOST=127.0.0.1
CHAT_REALTIME_PORT=8080
CHAT_REALTIME_PUSHER_CLUSTER=mt1
# Widget session token lifetime (seconds); capped server-side at max_ttl_seconds.
WIDGET_SESSION_TTL_SECONDS=900

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

# --- Redis (connection keys defined per ADR-010 / AGENTS env list.
#     Redis server is not provisioned yet in the dev environment, so queue, cache,
#     session, and broadcast currently use non-Redis drivers above. Switching to
#     Redis is a one-line driver change once a Redis server is available.) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Laravel Reverb (broadcast driver target per ADR-010; foundation only, no chat yet) ---
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_APP_ID=myvivah_ai
REVERB_APP_KEY=myvivah_ai_widget_key
REVERB_APP_SECRET=
REVERB_SCALING_ENABLED=false

# --- Pusher-compatible API (kept as fallback placeholder; Reverb is the decision) ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_APP_NAME="${APP_NAME}"
